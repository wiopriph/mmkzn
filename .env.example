# Скопируйте в .env и заполните (сам .env в git не попадает).

# Токен бота из @BotFather (/newbot)
NUXT_TELEGRAM_BOT_TOKEN=

# Куда слать заявки: id чата или несколько через запятую (123,456,-100789).
# Личка менеджера — он должен один раз написать боту /start; группа с ботом —
# id отрицательный (-100…). Узнать id:
#   curl "https://api.telegram.org/bot<ТОКЕН>/getUpdates" — поле chat.id
NUXT_TELEGRAM_CHAT_ID=

# Любая случайная строка — соль для хэширования IP (rate limit, сырой IP не храним)
NUXT_IP_SALT=

# Токен Figma — снятие геометрии макетов через REST API (нужен только разработке)
FIGMA_TOKEN=
